
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local PlaceId = 142823291

print("[System] Скрипт запущен!")



-- Проверка игроков
task.spawn(function()
    local playerCount = #Players:GetPlayers()
    print("[Check] Игроков: " .. playerCount)
    
    if playerCount < 4 then return end
    
    print("[Check] Толпа! Жду 5 сек...")
    task.wait(5)
    
    if #Players:GetPlayers() >= 4 then
        print("[Check] Всё еще толпа. Ищу новый...")
        FindAndJoin()
    end
end)

-- Обработка дисконнекта (в pcall, чтобы не сломать скрипт)
pcall(function()
    local GuiService = game:GetService("GuiService")
    GuiService.ErrorMessageChanged:Connect(function(msg)
        if msg and msg ~= "" then
            task.wait(0.5)
            FindAndJoin()
        end
    end)
end)



if queue_on_teleport then
    queue_on_teleport(loadstring(game:HttpGet("ССЫЛКА_НА_ТВОЙ_КОД"))())
    print("[Setup] Автоперезапуск настроен. Скрипт сам себя запустит после телепорта.")
else
    warn("[Setup] queue_on_teleport не найден в инжекторе!")
end
